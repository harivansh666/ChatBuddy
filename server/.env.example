# App Configuration
APP_NAME="ChatBuddy API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
# For local dev SQLite: sqlite+aiosqlite:///./app.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/chatbuddy
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# Security & JWT (Generate a 32+ char secret in production: openssl rand -hex 32)
JWT_SECRET_KEY="replace-this-with-a-very-long-random-secret-key-at-least-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
